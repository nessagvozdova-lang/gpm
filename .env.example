# Copy to .env.local (for Next.js) AND .env (for Prisma CLI).
DATABASE_URL="postgresql://store:store_dev_password@localhost:5432/maison_voyage?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Required for seeding a first admin; do not use a real password in source control.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"
# Customer support and storefront settings
STORE_SUPPORT_EMAIL="hello@example.com"
STORE_NAME="MAISON VOYAGE"
# Optional payment gateway, transactional email and image CDN credentials go here.
# Never put private API secrets in NEXT_PUBLIC_ variables.
